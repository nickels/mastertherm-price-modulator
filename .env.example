EVCC_URL=http://192.168.1.20:7070
# Optional: evcc API key, sent as Bearer token
# EVCC_API_KEY=
# Comma-separated evcc loadpoint titles
LOADPOINTS=MasterTherm,MasterTherm SHW
# Heat in the cheapest share of the look-ahead window
FRACTION=0.4
HOURS=24
# Do not change the limit when fewer hours of prices are known
MIN_HOURS=8
POLL_INTERVAL=900
DRY_RUN=false
LOG_LEVEL=INFO
