EVCC_URL=http://192.168.1.20:7070
# Optional: evcc API key, sent as Bearer token
# EVCC_API_KEY=
# Comma-separated evcc loadpoint titles, each title[:fraction[:floor loadpoint]]; the floor loadpoint's smart cost limit is the minimum
LOADPOINTS=MasterTherm:0.4,MasterTherm SHW:0.2:MasterTherm SHW Booster
# Fraction for a title without its own :fraction
FRACTION=0.4
HOURS=24
# Do not change the limit when fewer hours of prices are known
MIN_HOURS=8
POLL_INTERVAL=900
DRY_RUN=false
LOG_LEVEL=INFO
